# POC-only example values. Copy to .env during implementation.
# Do not commit real passwords or production secrets.

MSSQL_SA_PASSWORD=Change_me_for_local_poc_only_123
# Local sample uses sqlserver. For client UAT, set this to the DSB-SahiBnk SQL Server host/IP.
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_DATABASE=mbs_poc
# Target DSB-SahiBnk report source databases.
MSSQL_CAPTURE_DATABASES=EKYC_ICICI,EKYC_ICICI_Archived
KAFKA_TOPIC_PREFIX=mbs_poc
MSSQL_DEBEZIUM_USER=mbs_debezium_user
MSSQL_DEBEZIUM_PASSWORD=MbsDebezium@12345

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONNECT_URL=http://kafka-connect:8083

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
MINIO_BUCKET=lakehouse
MINIO_ENDPOINT=http://minio:9000

ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse
ICEBERG_CONTROL_TOPIC=mbs_iceberg_control

STARROCKS_FE_HOST=starrocks-fe
STARROCKS_DBT_HOST=127.0.0.1
STARROCKS_MYSQL_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_CATALOG=default_catalog
STARROCKS_SCHEMA=analytics

AIRFLOW__CORE__LOAD_EXAMPLES=false
DBT_TARGET=dev
